{
  "manifest_version": 3,
  "name": "Heros PDF",
  "version": "2.3.2",
  "description": "Heros PDF — fast, private PDF viewer & editor. Read, mark up, and edit PDFs locally. Free & unlimited.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Heros PDF",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "author": "Ahmed ABOBAKR",
  "homepage_url": "https://github.com/Ahmedbakr78/Heros_PDF"
}
